{
    "version": 8,
    "configurePresets": [
        {
            "name": "vs2022-x64",
            "displayName": "Visual Studio 2022 x64 (vcpkg)",
            "description": "Build with Visual Studio 2022 for x64 using vcpkg.",
            "generator": "Visual Studio 17 2022",
            "toolset": "host=x64",
            "architecture": "x64",
            "binaryDir": "${sourceDir}/build",
            "cacheVariables": {
                "CMAKE_INSTALL_PREFIX": "${sourceDir}/build/install",
                "CMAKE_TOOLCHAIN_FILE": "c:/DATA/vcpkg/scripts/buildsystems/vcpkg.cmake",
                "VCPKG_TARGET_TRIPLET": "x64-windows",
                "GGML_CCACHE": "OFF"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "vs2022-x64-debug",
            "displayName": "Visual Studio 2022 x64 - Debug",
            "configurePreset": "vs2022-x64",
            "configuration": "Debug"
        },
        {
            "name": "vs2022-x64-release",
            "displayName": "Visual Studio 2022 x64 - Release",
            "configurePreset": "vs2022-x64",
            "configuration": "Release"
        }
    ]
}